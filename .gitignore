# =========================================
# Secrets (절대 커밋 금지)
# =========================================
.env
.env.*
!.env.example
.streamlit/secrets.toml
*.pem
*.key
credentials.json
token.json

# =========================================
# Python
# =========================================
__pycache__/
*.py[cod]
*$py.class
*.so

# Build / Packaging
build/
dist/
*.egg-info/
*.egg
wheels/

# =========================================
# Virtual environment / Package manager
# =========================================
# poetry (virtualenvs.in-project = true)
.venv/
venv/

# 팀 표준은 poetry: uv는 Python 설치에만 사용
# 실수로 uv run / uv sync 실행 시 생기는 lock 파일 커밋 방지
uv.lock

# 커밋 대상 (ignore 금지)
#   pyproject.toml
#   poetry.lock
#   .python-version

# =========================================
# Test / Lint / Type check caches
# =========================================
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# =========================================
# Jupyter
# =========================================
.ipynb_checkpoints/

# =========================================
# LangChain / Vector stores
# =========================================
# 팀 표준 저장 경로
vectorstore/
# Chroma 기본 경로
chroma_db/
chroma/
.chroma/
# FAISS (save_local 결과물)
faiss_index/
*.faiss
# LangChain SQLite cache
.langchain.db

# =========================================
# Data (원본 문서, 업로드 파일)
# =========================================
data/raw/
uploads/
# 샘플 데이터는 data/sample/ 에 두고 커밋

# =========================================
# Streamlit / Gradio
# =========================================
# .streamlit/config.toml 은 커밋
.gradio/
flagged/
gradio_cached_examples/

# =========================================
# Logs
# =========================================
*.log
logs/

# =========================================
# OS / IDE
# =========================================
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json